					"when": "kernelDev.active"
				}
			],
			"editor/context": [
				{
					"command": "kernelDev.compileFile",
					"when": "kernelDev.active && resourceExtname =~ /^\\.[cS]$/",
					"group": "kernel@1"
				},
				{
					"command": "kernelDev.preprocessFile",
					"when": "kernelDev.active && resourceExtname == .c",
					"group": "kernel@2"
				},
				{
					"command": "kernelDev.assembleFile",
					"when": "kernelDev.active && resourceExtname == .c",
					"group": "kernel@3"
				},
				{
					"command": "kernelDev.history.showFile",
					"when": "kernelDev.active && resourceScheme == file",
					"group": "kernelGit@1"
				},
				{
					"command": "kernelDev.history.showLines",
					"when": "kernelDev.active && resourceScheme == file && editorHasSelection",
					"group": "kernelGit@2"
				},
				{
					"command": "kernelDev.blame.toggle",
					"when": "kernelDev.active && (resourceScheme == file || resourceScheme == kernel-git && resourcePath =~ /^\\/blob\\//)",
					"group": "kernelGit@0"
				}
			],
			"kernelDev.target": [
				{
					"command": "kernelDev.arch.x86_64",
					"group": "1_arch@0"
				},
				{
					"command": "kernelDev.arch.arm64",
					"group": "1_arch@1"
				},
				{
					"command": "kernelDev.arch.riscv64",
					"group": "1_arch@2"
				},
				{
					"command": "kernelDev.variant.debug",
					"group": "2_variant@1"
				},
				{
					"command": "kernelDev.variant.release",
					"group": "2_variant@2"
				},
				{
					"command": "kernelDev.selectConfig",
					"group": "3_config@1"
				},
				{
					"command": "kernelDev.menuconfig",
					"group": "3_config@2"
				},
				{
					"command": "kernelDev.clean",
					"group": "4_tools@1"
				},
				{
					"command": "kernelDev.rebuild",
					"group": "4_tools@2"
				},
				{
					"command": "kernelDev.mrproper",
					"group": "4_tools@3"
				},
				{
					"command": "kernelDev.openSettings",
					"group": "5_settings@1"
				}
			],
			"editor/title": [
				{
					"submenu": "kernelDev.target",
					"when": "kernelDev.active && resourceScheme != kernel-git",
					"group": "navigation@-10"
				},
				{
					"command": "kernelDev.configure",
					"when": "kernelDev.active && resourceScheme != kernel-git",
					"group": "navigation@-9"
				},
				{
					"command": "kernelDev.build",
					"when": "kernelDev.active && resourceScheme != kernel-git",
					"group": "navigation@-8"
				},
				{
					"command": "kernelDev.run",
					"when": "kernelDev.active && resourceScheme != kernel-git && !kernelDev.vmRunning",
					"group": "navigation@-7"
				},
				{
					"command": "kernelDev.debug",
					"when": "kernelDev.active && resourceScheme != kernel-git && !kernelDev.vmRunning",
					"group": "navigation@-6"
				},
				{
					"command": "kernelDev.stop",
					"when": "kernelDev.active && resourceScheme != kernel-git && kernelDev.vmRunning",
					"group": "navigation@-5"
				},
				{
					"command": "kernelDev.git.commitWhole",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/file\\//",
					"group": "navigation@1"
				},
				{
					"command": "kernelDev.git.commitFileOnly",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/full\\//",
					"group": "navigation@1"
				},
				{
					"command": "kernelDev.git.openOnLore",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/(commit|full|file)\\//",
					"group": "navigation@2"
				},
				{
					"command": "kernelDev.git.copyFixes",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/(commit|full|file)\\//",
					"group": "1_kernel@1"
				},
				{
					"command": "kernelDev.git.copyHash",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/(commit|full|file)\\//",
					"group": "1_kernel@2"
				},
				{
					"command": "kernelDev.blame.toggle",
					"when": "kernelDev.active && (resourceScheme == file || resourceScheme == kernel-git && resourcePath =~ /^\\/blob\\//)",
					"group": "1_kernel@0"
				}
			],
			"view/title": [
				{
					"command": "kernelDev.configure",
					"when": "view == kernelDev.panel",
					"group": "navigation@1"
				},
				{
					"command": "kernelDev.build",
					"when": "view == kernelDev.panel",
					"group": "navigation@2"
				},
				{
					"command": "kernelDev.run",
					"when": "view == kernelDev.panel",
					"group": "navigation@3"
				},
				{
					"command": "kernelDev.debug",
					"when": "view == kernelDev.panel",
					"group": "navigation@4"
				},
				{
					"command": "kernelDev.openSettings",
					"when": "view == kernelDev.panel",
					"group": "navigation@5"
				},
				{
					"command": "kernelDev.history.filter",
					"when": "view == kernelDev.history",
					"group": "navigation@1"
				},
				{
					"command": "kernelDev.history.clearFilter",
					"when": "view == kernelDev.history",
					"group": "navigation@2"
				},
				{
					"command": "kernelDev.history.refresh",
					"when": "view == kernelDev.history",
					"group": "navigation@3"
				},
				{
					"command": "kernelDev.blame.toggle",
					"when": "view == kernelDev.blame",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "kernelDev.git.copyHash",
					"when": "view == kernelDev.history && viewItem == commit",
					"group": "1_copy@1"
				},
				{
					"command": "kernelDev.git.copyFixes",
					"when": "view == kernelDev.history && viewItem == commit",
					"group": "1_copy@2"
				},
				{
					"command": "kernelDev.git.openAtCommit",
					"when": "view == kernelDev.history && viewItem == commit",
					"group": "2_open@1"
				},
				{
					"command": "kernelDev.git.compareWithPrevious",
					"when": "view == kernelDev.history && viewItem == commit",
					"group": "2_open@2"
				},
				{
					"command": "kernelDev.git.openOnLore",
					"when": "view == kernelDev.history && viewItem == commit",
					"group": "2_open@3"
				},
				{
					"command": "kernelDev.blame.before",
					"when": "view == kernelDev.blame && viewItem == blameCommit",
					"group": "inline"
				},
				{
					"command": "kernelDev.blame.before",
					"when": "view == kernelDev.blame && viewItem == blameCommit",
					"group": "1_blame@1"
				},
				{
					"command": "kernelDev.blame.copyFixes",
					"when": "view == kernelDev.blame && viewItem == blameCommit",
					"group": "2_copy@1"
				},
				{
					"command": "kernelDev.blame.copyHash",
					"when": "view == kernelDev.blame && viewItem == blameCommit",
					"group": "2_copy@2"
				},
				{
					"command": "kernelDev.blame.openOnLore",
					"when": "view == kernelDev.blame && viewItem == blameCommit",
					"group": "3_open@1"
				}
			],
			"explorer/context": [
				{
					"command": "kernelDev.history.showFile",
					"when": "kernelDev.active && !explorerResourceIsFolder",
					"group": "kernelGit@1"
				}
			]
		},
		"keybindings": [
			{
				"command": "kernelDev.build",
				"key": "f7",
				"when": "kernelDev.active"
			},
			{
				"command": "kernelDev.compileFile",
				"key": "ctrl+f7",
				"when": "kernelDev.active && editorLangId == c"
			},
			{
				"command": "kernelDev.debug",
				"key": "f5",
				"when": "kernelDev.active && !inDebugMode"
			},
			{
				"command": "kernelDev.run",
				"key": "ctrl+f5",
				"when": "kernelDev.active && !inDebugMode"
			}
		],
		"configuration": [
			{
				"title": "Configure",
				"order": 1,
				"properties": {
					"kernelDev.arch": {
						"type": "string",
						"enum": [
							"",
							"x86_64",
							"arm64",
							"riscv64"
						],
						"default": "",
						"description": "Default architecture for trees where none was picked in the Kernel panel. Empty: the host architecture."
					},
					"kernelDev.variant": {
						"type": "string",
						"enum": [
							"debug",
							"release"
						],
						"default": "debug",
						"description": "Default build variant for trees where none was picked in the Kernel panel."
					},
					"kernelDev.configure.defconfig": {
						"type": "string",
						"default": "defconfig",
						"markdownDescription": "Default base config: one or more make targets (`defconfig`, `defconfig kvm_guest.config`, `tinyconfig`) or a path to a `.config` file. The status bar picker overrides it per arch."
					},
					"kernelDev.configure.fragments": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Config fragments merged after the base config (`scripts/kconfig/merge_config.sh`). Paths relative to the kernel tree, e.g. `kernel/configs/debug.config`."
					},
					"kernelDev.configure.options": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "Kconfig options applied last, without the `CONFIG_` prefix: `\"y\"`, `\"n\"`, `\"m\"`, a number or a string. Example: `{ \"KASAN\": \"y\", \"LOG_BUF_SHIFT\": \"18\" }`."
					},
					"kernelDev.configure.debugOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"DEBUG_KERNEL": "y",
							"DEBUG_INFO_NONE": "n",
							"DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT": "y",
							"DEBUG_INFO_REDUCED": "n",
							"DEBUG_INFO_SPLIT": "n",
							"GDB_SCRIPTS": "y"
						},
						"markdownDescription": "Kconfig options for the **Debug** variant."
					},
					"kernelDev.configure.releaseOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"DEBUG_INFO_NONE": "y",
							"DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT": "n",
							"DEBUG_INFO_DWARF4": "n",
							"DEBUG_INFO_DWARF5": "n"
						},
						"markdownDescription": "Kconfig options for the **Release** variant."
					},
					"kernelDev.configure.qemuOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"BLK_DEV_INITRD": "y",
							"DEVTMPFS": "y",
							"DEVTMPFS_MOUNT": "y",
							"TMPFS": "y",
							"BINFMT_ELF": "y",
							"BINFMT_SCRIPT": "y"
						},
						"markdownDescription": "Kconfig options applied when `kernelDev.run.mode` is `qemu`, so the kernel can boot from an initramfs given in `kernelDev.run.initramfs`."
					},
					"kernelDev.configure.virtmeOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"BLK_DEV_INITRD": "y",
							"DEVTMPFS": "y",
							"TMPFS": "y",
							"BINFMT_SCRIPT": "y",
							"VIRTIO": "y",
							"VIRTIO_PCI": "y",
							"VIRTIO_MMIO": "y",
							"VIRTIO_CONSOLE": "y",
							"VIRTIO_BLK": "y",
							"VIRTIO_NET": "y",
							"SCSI_VIRTIO": "y",
							"NET_9P": "y",
							"NET_9P_VIRTIO": "y",
							"9P_FS": "y",
							"9P_FS_POSIX_ACL": "y",
							"FUSE_FS": "y",
							"VIRTIO_FS": "y",
							"OVERLAY_FS": "y",
							"UNIX": "y",
							"INET": "y"
						},
						"markdownDescription": "Kconfig options needed by virtme-ng (applied when `kernelDev.run.mode` is `virtme`)."
					}
				}
			},
			{
				"title": "Build",
				"order": 2,
				"properties": {
					"kernelDev.toolchain": {
						"type": "string",
						"enum": [
							"gcc",
							"llvm"
						],
						"default": "gcc",
						"markdownDescription": "`gcc`: `CROSS_COMPILE=<prefix>` when cross compiling. `llvm`: `LLVM=1` for every arch. Takes effect at the next Configure."
					},
					"kernelDev.crossCompile": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "`CROSS_COMPILE` prefix per arch for gcc builds. Defaults: `aarch64-linux-gnu-`, `riscv64-linux-gnu-`, `x86_64-linux-gnu-` (none for the host arch)."
					},
					"kernelDev.make.args": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Extra make arguments, recorded at Configure and used by every Build, e.g. `[\"W=1\"]`, `[\"CC=ccache gcc\"]`, `[\"KCFLAGS=-Og\"]`."
					},
					"kernelDev.make.jobs": {
						"type": "integer",
						"minimum": 0,
						"default": 0,
						"description": "make -j; 0 = number of CPUs."
					},
					"kernelDev.buildDirectory": {
						"type": "string",
						"default": "build/${arch}/${variant}",
						"markdownDescription": "Build output (`O=`), relative to the kernel tree or absolute. `${arch}` and `${variant}` are substituted."
					},
					"kernelDev.clangd.updateCompileCommands": {
						"type": "boolean",
						"default": true,
						"markdownDescription": "After each build, write the build's `compile_commands.json` to the root of the tree for clangd (gcc-only flags stripped) and restart clangd."
					},
					"kernelDev.terminal.afterTask": {
						"type": "string",
						"enum": [
							"waitForKey",
							"close"
						],
						"default": "waitForKey",
						"enumDescriptions": [
							"Keep the terminal open until you press a key",
							"Close the terminal as soon as the step finishes (errors stay in the Problems panel)"
						],
						"description": "What happens to the terminal of Configure / Build / Clean / Full clean when it finishes."
					}
				}
			},
			{
				"title": "Run",
				"order": 3,
				"properties": {
					"kernelDev.run.mode": {
						"type": "string",
						"enum": [
							"qemu",
							"virtme"
						],
						"default": "qemu",
						"markdownEnumDescriptions": [
							"QEMU, with the initramfs from `kernelDev.run.initramfs` if one is set",
							"virtme-ng (`vng`), booting the host root filesystem"
						],
						"description": "How Run and Debug boot the kernel."
					},
					"kernelDev.run.initramfs": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "Initramfs to boot with, per arch, e.g. `{ \"arm64\": \"/srv/initramfs/arm64.cpio.gz\" }`. If none is set for the arch, the kernel boots without an initramfs (give `root=` in `kernelDev.run.cmdline` and a disk in `kernelDev.run.qemuArgs`)."
					},
					"kernelDev.run.memory": {
						"type": "string",
						"default": "2G",
						"description": "Guest memory (QEMU -m)."
					},
					"kernelDev.run.smp": {
						"type": "integer",
						"minimum": 1,
						"default": 2,
						"description": "Guest CPUs (QEMU -smp)."
					},
					"kernelDev.run.kvm": {
						"type": "string",
						"enum": [
							"auto",
							"on",
							"off"
						],
						"default": "auto",
						"description": "auto: use KVM when the arch is native and /dev/kvm is accessible."
					},
					"kernelDev.run.cmdline": {
						"type": "string",
						"default": "",
						"description": "Extra kernel command line."
					},
					"kernelDev.run.qemuArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Extra QEMU arguments, e.g. `[\"-device\", \"virtio-rng-pci\"]`."
					},
					"kernelDev.run.virtmeArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Extra vng arguments (virtme mode)."
					},
					"kernelDev.buildBeforeRun": {
						"type": "boolean",
						"default": true,
						"description": "Run an incremental build before Run and Debug."
					}
				}
			},
			{
				"title": "Debug",
				"order": 4,
				"properties": {
					"kernelDev.debug.debugger": {
						"type": "string",
						"enum": [
							"auto",
							"cppdbg",
							"gdb",
							"lldb"
						],
						"default": "auto",
						"markdownEnumDescriptions": [
							"First installed of the below",
							"ms-vscode.cpptools (VS Code)",
							"webfreak.debug, Native Debug (VSCodium)",
							"CodeLLDB (no lx-* gdb helpers)"
						],
						"description": "Debugger front end."
					},
					"kernelDev.debug.gdb": {
						"type": "string",
						"default": "",
						"description": "gdb binary. Empty: gdb for the host arch, gdb-multiarch otherwise."
					},
					"kernelDev.debug.port": {
						"type": "integer",
						"default": 1234,
						"description": "QEMU gdbstub TCP port."
					},
					"kernelDev.debug.breakAt": {
						"type": "string",
						"default": "start_kernel",
						"description": "Run to this symbol (hardware breakpoint) before the debugger attaches, so normal breakpoints work. Empty: attach at reset."
					},
					"kernelDev.debug.stopOnEntry": {
						"type": "boolean",
						"default": false,
						"description": "Stay paused at breakAt when the debugger attaches, instead of running to your breakpoints."
					},
					"kernelDev.debug.gdbCommands": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Extra gdb commands run when the debugger starts."
					},
					"kernelDev.debug.stopVmWhenDebuggingEnds": {
						"type": "boolean",
						"default": true,
						"description": "Kill QEMU when the debug session ends."
					}
				}
			},
			{
				"title": "Git",
				"order": 5,
				"properties": {
					"kernelDev.blame.ignoreWhitespace": {
						"type": "boolean",
						"default": true,
						"markdownDescription": "Blame with `-w`: whitespace-only changes don't count as changing a line."
					},
					"kernelDev.blame.detectMoves": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Blame with `-M -C`: follow lines moved within the file or copied from other files changed in the same commit. Slower (about 6s instead of 2.4s on kernel/sched/core.c)."
					},
					"kernelDev.patches.base": {
						"type": "string",
						"default": "origin/master",
						"markdownDescription": "Base of a patch series when the branch has no upstream and none was picked in the Series view: the series is the commits since its merge-base with this ref."
					},
					"kernelDev.checkpatch.strict": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Run checkpatch with `--strict` (some subsystems, e.g. networking, expect it)."
					},
					"kernelDev.checkpatch.ignore": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "checkpatch types to ignore (`--ignore`), e.g. `[\"FILE_PATH_CHANGES\"]`."
					},
					"kernelDev.check.sparse": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Also run sparse (`C=2`) on the touched files in Check series. Needs a sparse recent enough for the kernel."
					},
					"kernelDev.check.coccinelle": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Also run `make coccicheck MODE=report` on the touched directories in Check series. Needs `coccinelle` and `ocaml-nox`."
					},
					"kernelDev.patches.outputDirectory": {
						"type": "string",
						"default": "patches/${branch}/v${version}",
						"markdownDescription": "Where Generate patches writes the series, relative to the kernel tree or absolute. `${branch}` and `${version}` are substituted."
					}
				}
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "kernelDev",
					"title": "Kernel",
					"icon": "media/kernel.svg"
				},
				{
					"id": "kernelGit",
					"title": "Kernel Git",
					"icon": "media/git.svg"
				}
			]
		},
		"views": {
			"kernelDev": [
				{
					"type": "webview",
					"id": "kernelDev.panel",
					"name": "Kernel",
					"when": "kernelDev.active"
				}
			],
			"kernelGit": [
				{
					"type": "webview",
					"id": "kernelDev.series",
					"name": "Series",
					"when": "kernelDev.active"
				},
				{
					"type": "webview",
					"id": "kernelDev.apply",
					"name": "Apply",
					"when": "kernelDev.active"
				},
				{
					"id": "kernelDev.blame",
					"name": "Blame",
					"when": "kernelDev.active"
				},
				{
					"id": "kernelDev.history",
					"name": "File History",
					"when": "kernelDev.active"
				}
			]
		},
		"submenus": [
			{
				"id": "kernelDev.target",
				"label": "Kernel Target (arch / Debug-Release / config)",
				"icon": "$(chip)"
			}
		],
		"problemMatchers": [
			{
				"name": "kernel-coccinelle",
				"owner": "coccinelle",
				"source": "coccinelle",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"severity": "warning",
				"pattern": {
					"regexp": "^([^\\s:]+\\.[ch]):(\\d+):(\\d+)-(\\d+): (?:(ERROR|WARNING|INFO): ?)?(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"endColumn": 4,
					"severity": 5,
					"message": 6
				}
			}
		]
	}
}
