{
	"name": "kernel-dev",
	"displayName": "Kernel Dev: Configure, Build, Run, Debug",
	"description": "Visual Studio-style Configure / Build / Run / Debug for the Linux kernel: a Kernel panel and editor toolbar with arch, Debug/Release and config; QEMU + gdb; clangd set up automatically. No per-workspace files.",
	"version": "0.5.0",
	"publisher": "ajose",
	"license": "GPL-2.0",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages",
		"Debuggers",
		"Other"
	],
	"keywords": [
		"linux",
		"kernel",
		"kbuild",
		"qemu",
		"gdb",
		"clangd"
	],
	"main": "./extension.js",
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"workspaceContains:Kbuild"
	],
	"contributes": {
		"commands": [
			{
				"command": "kernelDev.selectArch",
				"title": "Select Architecture",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.selectVariant",
				"title": "Select Debug / Release",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.selectConfig",
				"title": "Select Base Config",
				"category": "Kernel",
				"icon": "$(file-code)"
			},
			{
				"command": "kernelDev.configure",
				"title": "Configure",
				"category": "Kernel",
				"icon": "$(gear)"
			},
			{
				"command": "kernelDev.build",
				"title": "Build",
				"category": "Kernel",
				"icon": "$(tools)"
			},
			{
				"command": "kernelDev.rebuild",
				"title": "Rebuild (Clean + Build)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.clean",
				"title": "Clean",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.mrproper",
				"title": "Full Clean (mrproper)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.menuconfig",
				"title": "menuconfig",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.nconfig",
				"title": "nconfig",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.compileFile",
				"title": "Compile Current File",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.preprocessFile",
				"title": "Preprocess Current File (.i)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.assembleFile",
				"title": "Show Assembly for Current File (.s)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.run",
				"title": "Run (QEMU)",
				"category": "Kernel",
				"icon": "$(play)"
			},
			{
				"command": "kernelDev.debug",
				"title": "Debug (QEMU + gdb)",
				"category": "Kernel",
				"icon": "$(debug-alt)"
			},
			{
				"command": "kernelDev.stop",
				"title": "Stop VM",
				"category": "Kernel",
				"icon": "$(debug-stop)"
			},
			{
				"command": "kernelDev.checkTools",
				"title": "Check Required Tools",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.installTools",
				"title": "Install Missing Tools (apt)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.openSettings",
				"title": "Open Settings",
				"category": "Kernel",
				"icon": "$(settings)"
			},
			{
				"command": "kernelDev.arch.x86_64",
				"title": "x86_64",
				"category": "Kernel",
				"toggled": "kernelDev.arch == x86_64"
			},
			{
				"command": "kernelDev.arch.arm64",
				"title": "arm64",
				"category": "Kernel",
				"toggled": "kernelDev.arch == arm64"
			},
			{
				"command": "kernelDev.arch.riscv64",
				"title": "riscv64",
				"category": "Kernel",
				"toggled": "kernelDev.arch == riscv64"
			},
			{
				"command": "kernelDev.variant.debug",
				"title": "Debug",
				"category": "Kernel",
				"toggled": "kernelDev.variant == debug"
			},
			{
				"command": "kernelDev.variant.release",
				"title": "Release",
				"category": "Kernel",
				"toggled": "kernelDev.variant == release"
			},
			{
				"command": "kernelDev.followSelection",
				"title": "Point clangd at Selected Build",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.git.openCommit",
				"title": "Open Commit",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.git.commitWhole",
				"title": "Show Whole Commit",
				"category": "Kernel",
				"icon": "$(files)"
			},
			{
				"command": "kernelDev.git.commitFileOnly",
				"title": "Show Only This File",
				"category": "Kernel",
				"icon": "$(file)"
			},
			{
				"command": "kernelDev.history.showFile",
				"title": "Show File History",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.history.showLines",
				"title": "Show History of Selected Lines",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.history.loadMore",
				"title": "Load More History",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.history.refresh",
				"title": "Refresh",
				"category": "Kernel",
				"icon": "$(refresh)"
			},
			{
				"command": "kernelDev.history.filter",
				"title": "Filter by Message or Author…",
				"category": "Kernel",
				"icon": "$(filter)"
			},
			{
				"command": "kernelDev.history.clearFilter",
				"title": "Clear Filter",
				"category": "Kernel",
				"icon": "$(clear-all)"
			},
			{
				"command": "kernelDev.git.copyHash",
				"title": "Copy Commit Hash",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.git.copyFixes",
				"title": "Copy Fixes: Line",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.git.openAtCommit",
				"title": "Open File at This Commit",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.git.compareWithPrevious",
				"title": "Compare with Previous Version",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.git.openOnLore",
				"title": "Open on lore.kernel.org",
				"category": "Kernel",
				"icon": "$(link-external)"
			},
			{
				"command": "kernelDev.blame.toggle",
				"title": "Toggle Blame Annotations",
				"category": "Kernel",
				"icon": "$(person)"
			},
			{
				"command": "kernelDev.blame.before",
				"title": "Blame Before This Commit",
				"category": "Kernel",
				"icon": "$(history)"
			},
			{
				"command": "kernelDev.blame.copyFixes",
				"title": "Copy Fixes: Line",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.blame.copyHash",
				"title": "Copy Commit Hash",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.blame.openOnLore",
				"title": "Open on lore.kernel.org",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.series.checkWorking",
				"title": "Checkpatch Working Changes",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.series.check",
				"title": "Check Series (checkpatch + W=1)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.series.format",
				"title": "Format Changed Lines (git clang-format)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.series.pickBase",
				"title": "Pick Series Base…",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.series.editCover",
				"title": "Edit Cover Letter",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.series.generate",
				"title": "Generate Patches (git format-patch)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.apply.fetch",
				"title": "Apply Series from lore…",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.apply.openFiles",
				"title": "Apply mbox / Patch Files…",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.series.dryRun",
				"title": "Send Patches: Dry Run (git send-email --dry-run)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.series.send",
				"title": "Send Patches… (git send-email)",
				"category": "Kernel"
			}
		],
		"menus": {
