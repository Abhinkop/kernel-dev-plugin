				},
				{
					"command": "kernelDev.preprocessFile",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.assembleFile",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.run",
					"when": "kernelDev.active"
