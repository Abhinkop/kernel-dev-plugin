{
	"name": "kernel-dev",
	"displayName": "Kernel Dev: Configure, Build, Run, Debug",
	"description": "Visual Studio-style Configure / Build / Run / Debug for the Linux kernel: a Kernel panel and editor toolbar with arch, Debug/Release and config; QEMU + gdb; clangd set up automatically. No per-workspace files.",
	"version": "0.4.0",
	"publisher": "ajose",
	"license": "GPL-2.0",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages",
		"Debuggers",
		"Other"
	],
	"keywords": [
		"linux",
		"kernel",
		"kbuild",
		"qemu",
		"gdb",
		"clangd"
	],
	"main": "./extension.js",
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"workspaceContains:Kbuild"
	],
	"contributes": {
		"commands": [
			{
				"command": "kernelDev.selectArch",
				"title": "Select Architecture",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.selectVariant",
				"title": "Select Debug / Release",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.selectConfig",
				"title": "Select Base Config",
				"category": "Kernel",
				"icon": "$(file-code)"
			},
			{
				"command": "kernelDev.configure",
				"title": "Configure",
				"category": "Kernel",
				"icon": "$(gear)"
			},
			{
				"command": "kernelDev.build",
				"title": "Build",
				"category": "Kernel",
				"icon": "$(tools)"
			},
			{
				"command": "kernelDev.rebuild",
				"title": "Rebuild (Clean + Build)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.clean",
				"title": "Clean",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.mrproper",
				"title": "Full Clean (mrproper)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.menuconfig",
				"title": "menuconfig",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.nconfig",
				"title": "nconfig",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.compileFile",
				"title": "Compile Current File",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.preprocessFile",
				"title": "Preprocess Current File (.i)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.assembleFile",
				"title": "Show Assembly for Current File (.s)",
				"category": "Kernel"
			},
			{
				"command": "kernelDev.run",
				"title": "Run (QEMU)",
				"category": "Kernel",
				"icon": "$(play)"
			},
			{
				"command": "kernelDev.debug",
				"title": "Debug (QEMU + gdb)",
				"category": "Kernel",
				"icon": "$(debug-alt)"
			},
			{
				"command": "kernelDev.stop",
				"title": "Stop VM",
				"category": "Kernel",
				"icon": "$(debug-stop)"
			},
			{
				"command": "kernelDev.openSettings",
				"title": "Open Settings",
				"category": "Kernel",
				"icon": "$(settings)"
			},
			{
				"command": "kernelDev.arch.x86_64",
				"title": "x86_64",
				"category": "Kernel",
				"toggled": "kernelDev.arch == x86_64"
			},
			{
				"command": "kernelDev.arch.arm64",
				"title": "arm64",
				"category": "Kernel",
				"toggled": "kernelDev.arch == arm64"
			},
			{
				"command": "kernelDev.arch.riscv64",
				"title": "riscv64",
				"category": "Kernel",
				"toggled": "kernelDev.arch == riscv64"
			},
			{
				"command": "kernelDev.variant.debug",
				"title": "Debug",
				"category": "Kernel",
				"toggled": "kernelDev.variant == debug"
			},
			{
				"command": "kernelDev.variant.release",
				"title": "Release",
				"category": "Kernel",
				"toggled": "kernelDev.variant == release"
			},
			{
				"command": "kernelDev.followSelection",
				"title": "Point clangd at Selected Build",
				"category": "Kernel"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "kernelDev.selectArch",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.selectVariant",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.selectConfig",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.configure",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.build",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.rebuild",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.clean",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.mrproper",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.menuconfig",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.nconfig",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.compileFile",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.preprocessFile",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.assembleFile",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.run",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.debug",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.stop",
					"when": "kernelDev.active"
				},
				{
					"command": "kernelDev.arch.x86_64",
					"when": "false"
				},
				{
					"command": "kernelDev.arch.arm64",
					"when": "false"
				},
				{
					"command": "kernelDev.arch.riscv64",
					"when": "false"
				},
				{
					"command": "kernelDev.variant.debug",
					"when": "false"
				},
				{
					"command": "kernelDev.variant.release",
					"when": "false"
				},
				{
					"command": "kernelDev.followSelection",
					"when": "false"
				}
			],
			"editor/context": [
				{
					"command": "kernelDev.compileFile",
					"when": "kernelDev.active && resourceExtname =~ /^\\.[cS]$/",
					"group": "kernel@1"
				},
				{
					"command": "kernelDev.preprocessFile",
					"when": "kernelDev.active && resourceExtname == .c",
					"group": "kernel@2"
				},
				{
					"command": "kernelDev.assembleFile",
					"when": "kernelDev.active && resourceExtname == .c",
					"group": "kernel@3"
				}
			],
			"kernelDev.target": [
				{
					"command": "kernelDev.arch.x86_64",
					"group": "1_arch@0"
				},
				{
					"command": "kernelDev.arch.arm64",
					"group": "1_arch@1"
				},
				{
					"command": "kernelDev.arch.riscv64",
					"group": "1_arch@2"
				},
				{
					"command": "kernelDev.variant.debug",
					"group": "2_variant@1"
				},
				{
					"command": "kernelDev.variant.release",
					"group": "2_variant@2"
				},
				{
					"command": "kernelDev.selectConfig",
					"group": "3_config@1"
				},
				{
					"command": "kernelDev.menuconfig",
					"group": "3_config@2"
				},
				{
					"command": "kernelDev.clean",
					"group": "4_tools@1"
				},
				{
					"command": "kernelDev.rebuild",
					"group": "4_tools@2"
				},
				{
					"command": "kernelDev.mrproper",
					"group": "4_tools@3"
				},
				{
					"command": "kernelDev.openSettings",
					"group": "5_settings@1"
				}
			],
			"editor/title": [
				{
					"submenu": "kernelDev.target",
					"when": "kernelDev.active",
					"group": "navigation@-10"
				},
				{
					"command": "kernelDev.configure",
					"when": "kernelDev.active",
					"group": "navigation@-9"
				},
				{
					"command": "kernelDev.build",
					"when": "kernelDev.active",
					"group": "navigation@-8"
				},
				{
					"command": "kernelDev.run",
					"when": "kernelDev.active && !kernelDev.vmRunning",
					"group": "navigation@-7"
				},
				{
					"command": "kernelDev.debug",
					"when": "kernelDev.active && !kernelDev.vmRunning",
					"group": "navigation@-6"
				},
				{
					"command": "kernelDev.stop",
					"when": "kernelDev.active && kernelDev.vmRunning",
					"group": "navigation@-5"
				}
			]
		},
		"keybindings": [
			{
				"command": "kernelDev.build",
				"key": "f7",
				"when": "kernelDev.active"
			},
			{
				"command": "kernelDev.compileFile",
				"key": "ctrl+f7",
				"when": "kernelDev.active && editorLangId == c"
			},
			{
				"command": "kernelDev.debug",
				"key": "f5",
				"when": "kernelDev.active && !inDebugMode"
			},
			{
				"command": "kernelDev.run",
				"key": "ctrl+f5",
				"when": "kernelDev.active && !inDebugMode"
			}
		],
		"configuration": [
			{
				"title": "Configure",
				"order": 1,
				"properties": {
					"kernelDev.arch": {
						"type": "string",
						"enum": [
							"",
							"x86_64",
							"arm64",
							"riscv64"
						],
						"default": "",
						"description": "Default architecture for trees where none was picked in the Kernel panel. Empty: the host architecture."
					},
					"kernelDev.variant": {
						"type": "string",
						"enum": [
							"debug",
							"release"
						],
						"default": "debug",
						"description": "Default build variant for trees where none was picked in the Kernel panel."
					},
					"kernelDev.configure.defconfig": {
						"type": "string",
						"default": "defconfig",
						"markdownDescription": "Default base config: one or more make targets (`defconfig`, `defconfig kvm_guest.config`, `tinyconfig`) or a path to a `.config` file. The status bar picker overrides it per arch."
					},
					"kernelDev.configure.fragments": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Config fragments merged after the base config (`scripts/kconfig/merge_config.sh`). Paths relative to the kernel tree, e.g. `kernel/configs/debug.config`."
					},
					"kernelDev.configure.options": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "Kconfig options applied last, without the `CONFIG_` prefix: `\"y\"`, `\"n\"`, `\"m\"`, a number or a string. Example: `{ \"KASAN\": \"y\", \"LOG_BUF_SHIFT\": \"18\" }`."
					},
					"kernelDev.configure.debugOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"DEBUG_KERNEL": "y",
							"DEBUG_INFO_NONE": "n",
							"DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT": "y",
							"DEBUG_INFO_REDUCED": "n",
							"DEBUG_INFO_SPLIT": "n",
							"GDB_SCRIPTS": "y"
						},
						"markdownDescription": "Kconfig options for the **Debug** variant."
					},
					"kernelDev.configure.releaseOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"DEBUG_INFO_NONE": "y",
							"DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT": "n",
							"DEBUG_INFO_DWARF4": "n",
							"DEBUG_INFO_DWARF5": "n"
						},
						"markdownDescription": "Kconfig options for the **Release** variant."
					},
					"kernelDev.configure.initramfsOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"BLK_DEV_INITRD": "y",
							"DEVTMPFS": "y",
							"DEVTMPFS_MOUNT": "y",
							"TMPFS": "y",
							"BINFMT_ELF": "y",
							"BINFMT_SCRIPT": "y"
						},
						"markdownDescription": "Kconfig options needed to boot the busybox initramfs (applied when `kernelDev.run.mode` is `initramfs`)."
					},
					"kernelDev.configure.virtmeOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"BLK_DEV_INITRD": "y",
							"DEVTMPFS": "y",
							"TMPFS": "y",
							"BINFMT_SCRIPT": "y",
							"VIRTIO": "y",
							"VIRTIO_PCI": "y",
							"VIRTIO_MMIO": "y",
							"VIRTIO_CONSOLE": "y",
							"VIRTIO_BLK": "y",
							"VIRTIO_NET": "y",
							"SCSI_VIRTIO": "y",
							"NET_9P": "y",
							"NET_9P_VIRTIO": "y",
							"9P_FS": "y",
							"9P_FS_POSIX_ACL": "y",
							"FUSE_FS": "y",
							"VIRTIO_FS": "y",
							"OVERLAY_FS": "y",
							"UNIX": "y",
							"INET": "y"
						},
						"markdownDescription": "Kconfig options needed by virtme-ng (applied when `kernelDev.run.mode` is `virtme`)."
					}
				}
			},
			{
				"title": "Build",
				"order": 2,
				"properties": {
					"kernelDev.toolchain": {
						"type": "string",
						"enum": [
							"gcc",
							"llvm"
						],
						"default": "gcc",
						"markdownDescription": "`gcc`: `CROSS_COMPILE=<prefix>` when cross compiling. `llvm`: `LLVM=1` for every arch. Takes effect at the next Configure."
					},
					"kernelDev.crossCompile": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "`CROSS_COMPILE` prefix per arch for gcc builds. Defaults: `aarch64-linux-gnu-`, `riscv64-linux-gnu-`, `x86_64-linux-gnu-` (none for the host arch)."
					},
					"kernelDev.make.args": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Extra make arguments, recorded at Configure and used by every Build, e.g. `[\"W=1\"]`, `[\"CC=ccache gcc\"]`, `[\"KCFLAGS=-Og\"]`."
					},
					"kernelDev.make.jobs": {
						"type": "integer",
						"minimum": 0,
						"default": 0,
						"description": "make -j; 0 = number of CPUs."
					},
					"kernelDev.buildDirectory": {
						"type": "string",
						"default": "build/${arch}/${variant}",
						"markdownDescription": "Build output (`O=`), relative to the kernel tree or absolute. `${arch}` and `${variant}` are substituted."
					},
					"kernelDev.clangd.updateCompileCommands": {
						"type": "boolean",
						"default": true,
						"markdownDescription": "After each build, write the build's `compile_commands.json` to the root of the tree for clangd (gcc-only flags stripped) and restart clangd."
					},
					"kernelDev.terminal.afterTask": {
						"type": "string",
						"enum": [
							"waitForKey",
							"close"
						],
						"default": "waitForKey",
						"enumDescriptions": [
							"Keep the terminal open until you press a key",
							"Close the terminal as soon as the step finishes (errors stay in the Problems panel)"
						],
						"description": "What happens to the terminal of Configure / Build / Clean / Full clean when it finishes."
					}
				}
			},
			{
				"title": "Run",
				"order": 3,
				"properties": {
					"kernelDev.run.mode": {
						"type": "string",
						"enum": [
							"initramfs",
							"virtme"
						],
						"default": "initramfs",
						"markdownEnumDescriptions": [
							"QEMU with an initramfs packed around your busybox",
							"virtme-ng (`vng`), booting the host root filesystem"
						],
						"description": "How Run and Debug boot the kernel."
					},
					"kernelDev.run.busybox": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "Path to a **statically linked** busybox per arch, used to build the initramfs. Example: `{ \"arm64\": \"/opt/busybox/arm64/busybox\" }`. For the host arch, `busybox` on PATH is used if not set."
					},
					"kernelDev.run.initramfs": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"description": "Use this initramfs per arch instead of packing one from busybox."
					},
					"kernelDev.run.memory": {
						"type": "string",
						"default": "2G",
						"description": "Guest memory (QEMU -m)."
					},
					"kernelDev.run.smp": {
						"type": "integer",
						"minimum": 1,
						"default": 2,
						"description": "Guest CPUs (QEMU -smp)."
					},
					"kernelDev.run.kvm": {
						"type": "string",
						"enum": [
							"auto",
							"on",
							"off"
						],
						"default": "auto",
						"description": "auto: use KVM when the arch is native and /dev/kvm is accessible."
					},
					"kernelDev.run.cmdline": {
						"type": "string",
						"default": "",
						"description": "Extra kernel command line."
					},
					"kernelDev.run.qemuArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Extra QEMU arguments, e.g. `[\"-device\", \"virtio-rng-pci\"]`."
					},
					"kernelDev.run.virtmeArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Extra vng arguments (virtme mode)."
					},
					"kernelDev.buildBeforeRun": {
						"type": "boolean",
						"default": true,
						"description": "Run an incremental build before Run and Debug."
					}
				}
			},
			{
				"title": "Debug",
				"order": 4,
				"properties": {
					"kernelDev.debug.debugger": {
						"type": "string",
						"enum": [
							"auto",
							"cppdbg",
							"gdb",
							"lldb"
						],
						"default": "auto",
						"markdownEnumDescriptions": [
							"First installed of the below",
							"ms-vscode.cpptools (VS Code)",
							"webfreak.debug, Native Debug (VSCodium)",
							"CodeLLDB (no lx-* gdb helpers)"
						],
						"description": "Debugger front end."
					},
					"kernelDev.debug.gdb": {
						"type": "string",
						"default": "",
						"description": "gdb binary. Empty: gdb for the host arch, gdb-multiarch otherwise."
					},
					"kernelDev.debug.port": {
						"type": "integer",
						"default": 1234,
						"description": "QEMU gdbstub TCP port."
					},
					"kernelDev.debug.breakAt": {
						"type": "string",
						"default": "start_kernel",
						"description": "Run to this symbol (hardware breakpoint) before the debugger attaches, so normal breakpoints work. Empty: attach at reset."
					},
					"kernelDev.debug.stopOnEntry": {
						"type": "boolean",
						"default": false,
						"description": "Stay paused at breakAt when the debugger attaches, instead of running to your breakpoints."
					},
					"kernelDev.debug.gdbCommands": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Extra gdb commands run when the debugger starts."
					},
					"kernelDev.debug.stopVmWhenDebuggingEnds": {
						"type": "boolean",
						"default": true,
						"description": "Kill QEMU when the debug session ends."
					}
				}
			}
		],
		"submenus": [
			{
				"id": "kernelDev.target",
				"label": "Kernel Target (arch / Debug-Release / config)",
				"icon": "$(chip)"
			}
		]
	}
}
